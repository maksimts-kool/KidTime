# Generated by scripts/initialize-server.sh on the Ubuntu Docker host.
# With Portainer, paste these lines into the stack's environment variables.
POSTGRES_PASSWORD=replace-with-a-long-random-password
KIDTIME_JWT_KEY=replace-with-at-least-32-random-bytes
KIDTIME_ADMIN_EMAIL=parent@kidtime.local
KIDTIME_ADMIN_PASSWORD=replace-with-a-strong-parent-password
KIDTIME_CERT_PASSWORD=replace-with-a-random-certificate-password

# HTTPS address the controlled Windows PCs use to reach the agent API. On a plain LAN
# server this is the host itself; behind a reverse proxy it is the public URL, including
# any path prefix the proxy strips before forwarding.
KIDTIME_AGENT_URL=https://192.168.0.10:5081

# Host directories bind-mounted into the server container.
KIDTIME_CERT_DIR=/opt/kidtime/certs
KIDTIME_RELEASE_DIR=/opt/kidtime/releases

# Published ports. Set KIDTIME_BIND=127.0.0.1 when a reverse proxy on the same host is
# the only client, and change the ports when the defaults are already taken.
KIDTIME_BIND=0.0.0.0
KIDTIME_SERVER_PORT=5081
KIDTIME_WEB_PORT=3000

# Path prefix the panel is served under, empty for the domain root. Next.js inlines this
# at image build time, so changing it requires rebuilding the web image.
KIDTIME_BASE_PATH=

# Optional: the Technitium DNS Companion that filters this household's web traffic. With these
# set, the panel grows a Web filtering page whose button opens the DNS console, and the child's
# KidTime window grows an Internet tab describing what is blocked. KidTime only reads the
# configuration - it never writes to the DNS server and never reads its query logs.
#
# KIDTIME_DNS_API_URL is how the KidTime server reaches the companion; on one Docker host that
# can be the container name. KIDTIME_DNS_CONSOLE_URL is the address the parent's browser opens,
# and is only needed when it differs. KIDTIME_DNS_CERT_PIN is the SHA-256 of the companion's
# certificate, checked only when ordinary validation fails, which is what makes its self-signed
# certificate usable; read it with
#   openssl s_client -connect HOST:8095 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
# KIDTIME_DNS_GROUP names the advanced-blocking group this household's PCs fall in, and can be
# left empty when the DNS server has only one.
#
# KIDTIME_DNS_NETWORK and KIDTIME_DNS_EXTERNAL are for the common case where the companion is
# another Compose stack on this same host. Naming its Docker network (and saying that it already
# exists) puts the server container on it, so KIDTIME_DNS_API_URL can be the companion's own
# container name and port - the read never leaves the host, needs no firewall rule, and does not
# depend on the reverse proxy that publishes the console to the parent. Leave both empty and the
# server reaches the companion however the rest of the network lets it.
#   KIDTIME_DNS_NETWORK=technitium_technitium
#   KIDTIME_DNS_EXTERNAL=true
KIDTIME_DNS_API_URL=
KIDTIME_DNS_CONSOLE_URL=
KIDTIME_DNS_USERNAME=
KIDTIME_DNS_PASSWORD=
KIDTIME_DNS_NODE_ID=node1
KIDTIME_DNS_GROUP=
KIDTIME_DNS_CERT_PIN=
