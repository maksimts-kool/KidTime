<ui:FluentWindow x:Class="KidTime.SessionAgent.StatusWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="KidTime"
                 Width="980"
                 Height="760"
                 MinWidth="820"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="KidTime"
                     Icon="{ui:SymbolIcon ShieldCheckmark24}"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1120" Margin="30,20,30,32">
                <Grid Margin="2,0,2,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Variable Display"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Text="Your time today" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14"
                                   Text="A live view of screen time, schedules, and controlled apps." />
                    </StackPanel>
                    <ui:Badge x:Name="OverallBadge"
                              Grid.Column="1"
                              Margin="16,6,0,0"
                              Padding="12,6"
                              VerticalAlignment="Top"
                              Appearance="Info"
                              Content="Connecting" />
                </Grid>

                <ui:Card Margin="0,0,0,18" Padding="26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="214" Height="214" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing x:Name="DailyRing"
                                             Width="204"
                                             Height="204"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             CoverRingStroke="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                                             IsIndeterminate="True"
                                             Progress="0" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="RemainingText"
                                           MaxWidth="150"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Variable Display"
                                           FontSize="29"
                                           FontWeight="SemiBold"
                                           Text="--"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RemainingCaption"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13"
                                           Text="loading time"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe UI Variable Display"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="Daily screen time" />
                            <TextBlock x:Name="DailyUsageText"
                                       Margin="0,5,0,18"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="14"
                                       Text="Waiting for the service..." />

                            <Border Padding="16,14"
                                    Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="CalendarClock24" FontSize="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="WEEKLY SCHEDULE" />
                                            <TextBlock x:Name="ScheduleHeadline"
                                                       Margin="0,3,0,0"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Text="Loading schedule" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="ScheduleProgress"
                                                 Grid.Row="1"
                                                 Height="7"
                                                 Margin="34,14,0,0"
                                                 Maximum="100"
                                                 Visibility="Collapsed" />
                                    <TextBlock x:Name="ScheduleDetail"
                                               Grid.Row="2"
                                               Margin="34,8,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Schedule information will appear here."
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <ui:InfoBar x:Name="RestrictionInfo"
                                        Margin="0,14,0,0"
                                        IsClosable="False"
                                        IsOpen="False"
                                        Severity="Warning"
                                        Title="Screen time unavailable" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <TextBlock Margin="2,0,0,10"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Control status" />
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38"
                                    Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                <ui:SymbolIcon x:Name="ServerIcon" Symbol="CloudCheckmark24" FontSize="22" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="SERVER" />
                                <TextBlock x:Name="ServerStatusText" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="Connecting" />
                                <TextBlock x:Name="ServerDetailText" Margin="0,3,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="No contact yet" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38"
                                    Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                <ui:SymbolIcon x:Name="SyncIcon" Symbol="ArrowSync24" FontSize="22" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="SYNCHRONIZATION" />
                                <TextBlock x:Name="SyncStatusText" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="Waiting" />
                                <TextBlock x:Name="SyncDetailText" Margin="0,3,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Cached rules active" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="4" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38"
                                    Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                <ui:SymbolIcon Symbol="Person24" FontSize="22" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="CONTROLLED PROFILE" />
                                <TextBlock x:Name="ProfileStatusText" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="Loading" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ProfileDetailText" Margin="0,3,0,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Rule revision --" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>

                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe UI Variable Display"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Apps with limits or blocks" />
                    <ui:Badge x:Name="AppsCountBadge"
                              Grid.Column="1"
                              Padding="9,4"
                              Appearance="Secondary"
                              Content="0" />
                </Grid>

                <ui:Card x:Name="EmptyAppsCard" Padding="24">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" Symbol="CheckmarkCircle24" FontSize="32" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="No app limits or blocks" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Only controlled apps appear in this list." />
                    </StackPanel>
                </ui:Card>

                <ItemsControl x:Name="ApplicationsItems" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,10" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Width="40" Height="40"
                                            Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="23" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding DailySummary}" />
                                    </StackPanel>
                                    <ui:Badge Grid.Column="2"
                                              Margin="12,3,0,0"
                                              Padding="10,5"
                                              VerticalAlignment="Top"
                                              Appearance="{Binding StatusAppearance}"
                                              Content="{Binding StatusText}" />

                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ProgressBar Height="6"
                                                     Maximum="100"
                                                     Value="{Binding DailyRemainingPercent}"
                                                     Visibility="{Binding DailyProgressVisibility}" />
                                        <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,7,0" Symbol="CalendarClock20" FontSize="18" />
                                            <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding ScheduleSummary}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Card Margin="0,16,0,0" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Remove KidTime from this PC" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       Text="A parent must sign in online before the Windows service, local rules, usage data, and program files can be removed."
                                       TextWrapping="Wrap" />
                            <ui:InfoBar x:Name="RemovalInfo"
                                        Margin="0,12,0,0"
                                        IsClosable="False"
                                        IsOpen="False" />
                        </StackPanel>
                        <ui:Button x:Name="RemoveKidTimeButton"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Appearance="Danger"
                                   Click="RemoveKidTimeButton_Click"
                                   Content="Remove KidTime" />
                    </Grid>
                </ui:Card>

                <TextBlock x:Name="UpdatedText"
                           Margin="2,8,2,0"
                           HorizontalAlignment="Right"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           Text="Waiting for live status" />
            </StackPanel>
        </ScrollViewer>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
