<!--
    MinWidth and MinHeight are pinned to zero on purpose. The FluentWindow style ships a minimum
    size (460x320) meant for ordinary application windows, and it silently overrides both the
    declared width and SizeToContent: the card grew past the screen edge, cutting off the very
    countdown it exists to show, and padded the rest with empty space. Removing these two lines
    brings that back.
-->
<ui:FluentWindow x:Class="KidTime.SessionAgent.CountdownCardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="KidTime"
                 Width="380"
                 SizeToContent="Height"
                 MinWidth="0"
                 MinHeight="0"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowActivated="False"
                 Topmost="True"
                 Focusable="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Border Padding="18,16"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                    <ui:SymbolIcon Symbol="Clock24"
                                   FontSize="20"
                                   Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="KidTime"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountdownText"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas, Cascadia Mono, Segoe UI"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                           Text="0:00" />
            </Grid>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="46,8,0,0"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13"
                       Text=""
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="RemainingBar"
                         Grid.Row="2"
                         Height="5"
                         Margin="46,12,0,0"
                         Maximum="100"
                         Value="100" />

            <!--
                The ask gets its own full-width row rather than sharing one with "Got it". Both
                labels are sentences, not words - "Попросить ещё времени" beside "Понятно" beside
                the caption ran straight through each other on a 380-wide card - and a warning
                whose buttons overlap is a warning that looks broken at the worst moment.
                Shown only while the service is offering extra time for what is closing; it opens
                the request and does nothing else, so the card stays a warning.
            -->
            <ui:Button x:Name="AskForTimeButton"
                       Grid.Row="3"
                       Margin="46,12,0,0"
                       Padding="12,6"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Appearance="Primary"
                       Click="AskForTimeButton_Click"
                       Content="Ask for more time"
                       Focusable="False"
                       Visibility="Collapsed" />

            <Grid Grid.Row="4" Margin="46,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountdownCaption"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           Text="Time left"
                           TextTrimming="CharacterEllipsis" />
                <ui:Button x:Name="DismissButton"
                           Grid.Column="1"
                           Padding="12,5"
                           Appearance="Secondary"
                           Click="DismissButton_Click"
                           Content="Got it"
                           Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
