<ui:FluentWindow x:Class="KidTime.SessionAgent.CountdownCardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="KidTime"
                 Width="380"
                 SizeToContent="Height"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowActivated="False"
                 Topmost="True"
                 Focusable="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Border Padding="18,16"
            Background="{ui:ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                    <ui:SymbolIcon Symbol="Clock24"
                                   FontSize="20"
                                   Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="KidTime"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountdownText"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas, Cascadia Mono, Segoe UI"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                           Text="0:00" />
            </Grid>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="46,8,0,0"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13"
                       Text=""
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="RemainingBar"
                         Grid.Row="2"
                         Height="5"
                         Margin="46,12,0,0"
                         Maximum="100"
                         Value="100" />

            <Grid Grid.Row="3" Margin="46,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountdownCaption"
                           VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           Text="Time left" />
                <ui:Button x:Name="DismissButton"
                           Grid.Column="1"
                           Padding="12,5"
                           Appearance="Secondary"
                           Click="DismissButton_Click"
                           Content="Got it"
                           Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
