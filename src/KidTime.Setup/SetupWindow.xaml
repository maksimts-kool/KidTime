<ui:FluentWindow x:Class="KidTime.Setup.SetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="KidTime Setup"
                 Width="780"
                 Height="740"
                 MinWidth="720"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="KidTime Setup"
                     Icon="{ui:SymbolIcon ShieldCheckmark24}"
                     ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="32,8,32,0">
            <TextBlock FontFamily="Segoe UI Variable Display"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="Connect this PC to KidTime" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="14"
                       Text="Fill in the details from Add device in the parent web panel, choose the child account, then connect."
                       TextWrapping="Wrap" />

            <Grid Margin="0,20,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="Step1Circle" Style="{StaticResource StepCircleActive}">
                        <Grid>
                            <TextBlock x:Name="Step1Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="1" />
                            <ui:SymbolIcon x:Name="Step1Check" Symbol="Checkmark24" FontSize="16" Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Step1Label" Style="{StaticResource StepLabelActive}" Text="Connection" />
                </StackPanel>
                <Rectangle x:Name="Connector1" Grid.Column="1" Height="1" Margin="14,0" VerticalAlignment="Center" Fill="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border x:Name="Step2Circle" Style="{StaticResource StepCirclePending}">
                        <Grid>
                            <TextBlock x:Name="Step2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="2" />
                            <ui:SymbolIcon x:Name="Step2Check" Symbol="Checkmark24" FontSize="16" Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Step2Label" Style="{StaticResource StepLabelPending}" Text="Child account" />
                </StackPanel>
                <Rectangle x:Name="Connector2" Grid.Column="3" Height="1" Margin="14,0" VerticalAlignment="Center" Fill="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Border x:Name="Step3Circle" Style="{StaticResource StepCirclePending}">
                        <Grid>
                            <TextBlock x:Name="Step3Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="3" />
                            <ui:SymbolIcon x:Name="Step3Check" Symbol="Checkmark24" FontSize="16" Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Step3Label" Style="{StaticResource StepLabelPending}" Text="Connect" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,0,32,24">

                <!--  Step 1: required connection details  -->
                <StackPanel x:Name="ConnectionStep">
                    <ui:Card Padding="26">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Server URL" />
                            <TextBlock Style="{StaticResource FieldCaption}" Text="The HTTPS address of the parent PC, exactly as Add device shows it. Required." />
                            <ui:TextBox x:Name="ServerUrlBox"
                                        AutomationProperties.Name="Server URL"
                                        Icon="{ui:SymbolIcon Globe24}"
                                        PlaceholderText="https://parent-pc:5081"
                                        TextChanged="Input_TextChanged" />
                            <TextBlock x:Name="ServerUrlError" Style="{StaticResource FieldError}" />

                            <TextBlock Margin="0,24,0,0" Style="{StaticResource FieldLabel}" Text="Enrollment code" />
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Paste the one-time code from Add device. Required. A full setup code also fills the server URL for you." />
                            <ui:TextBox x:Name="EnrollmentCodeBox"
                                        MinHeight="76"
                                        AcceptsReturn="False"
                                        AutomationProperties.Name="Enrollment code"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="13"
                                        Icon="{ui:SymbolIcon Key24}"
                                        PlaceholderText="KTS1… or KT1…"
                                        TextChanged="Input_TextChanged"
                                        TextWrapping="Wrap"
                                        VerticalContentAlignment="Top" />
                            <TextBlock x:Name="EnrollmentCodeError" Style="{StaticResource FieldError}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:InfoBar x:Name="ConnectionInfo"
                                Margin="0,16,0,0"
                                IsClosable="False"
                                IsOpen="False" />

                    <StackPanel Margin="4,18,0,0" Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,1,9,0" Symbol="LockClosed24" FontSize="17" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock MaxWidth="600"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   Text="The code expires, works once, and carries the server certificate fingerprint so this PC only ever trusts your own KidTime server."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!--  Step 2: required Windows account  -->
                <StackPanel x:Name="AccountStep" Visibility="Collapsed">
                    <ui:Card Padding="26">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Child account" />
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="KidTime controls this one Windows profile. Required. Administrator and disabled accounts are never offered." />
                                </StackPanel>
                                <ui:Button x:Name="RefreshAccountsButton"
                                           Grid.Column="1"
                                           VerticalAlignment="Top"
                                           Click="RefreshAccountsButton_Click"
                                           Content="Refresh"
                                           Icon="{ui:SymbolIcon ArrowClockwise24}" />
                            </Grid>

                            <ui:InfoBar x:Name="AccountsInfo"
                                        Margin="0,4,0,0"
                                        IsClosable="False"
                                        IsOpen="False"
                                        Severity="Warning" />

                            <ItemsControl x:Name="AccountItems" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Margin="0,0,0,8"
                                                     Padding="0"
                                                     HorizontalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     Checked="Account_Checked"
                                                     GroupName="ChildAccount"
                                                     Tag="{Binding}">
                                            <Grid Margin="6,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32"
                                                        Height="32"
                                                        HorizontalAlignment="Left"
                                                        Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="16">
                                                    <ui:SymbolIcon Symbol="Person24" FontSize="18" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                               FontSize="12"
                                                               Text="{Binding AccountName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Margin="4,18,0,0" Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,1,9,0" Symbol="Person24" FontSize="17" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock MaxWidth="600"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   Text="The account is stored by Windows security identifier, so renaming it later does not widen what KidTime controls. You can change it in the web panel."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!--  Step 3: review and connect  -->
                <StackPanel x:Name="ConnectStep" Visibility="Collapsed">
                    <ui:Card Padding="26">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Review" />
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Check these details before this PC connects to your KidTime server." />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SummaryLabel}" Text="This PC" />
                                <TextBlock x:Name="SummaryComputer" Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryValue}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SummaryLabel}" Text="Windows" />
                                <TextBlock x:Name="SummaryWindows" Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValue}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SummaryLabel}" Text="KidTime server" />
                                <TextBlock x:Name="SummaryServer" Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryValue}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SummaryLabel}" Text="Child account" />
                                <TextBlock x:Name="SummaryAccount" Grid.Row="3" Grid.Column="1" Style="{StaticResource SummaryValue}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SummaryLabel}" Text="Install location" />
                                <TextBlock x:Name="SummaryLocation" Grid.Row="4" Grid.Column="1" Style="{StaticResource SummaryValue}" Text="C:\Program Files\KidTime" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,14,0,0" Padding="26">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="What happens next" />
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,1,10,0" Symbol="Box24" FontSize="18" />
                                    <TextBlock FontSize="13" Text="Install the KidTime service files and protect them from the child account." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,1,10,0" Symbol="PlugConnected24" FontSize="18" />
                                    <TextBlock FontSize="13" Text="Redeem the one-time code over a certificate-pinned HTTPS connection." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,1,10,0" Symbol="Play24" FontSize="18" />
                                    <TextBlock FontSize="13" Text="Start the KidTimeControl service so limits apply after every restart." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,1,10,0" Symbol="ShieldCheckmark24" FontSize="18" />
                                    <TextBlock FontSize="13" Text="Windows Defender, UAC, and the firewall are left exactly as they are." TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:InfoBar x:Name="ConnectError"
                                Margin="0,16,0,0"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Error"
                                Title="Could not connect this PC" />
                </StackPanel>

                <!--  Completion  -->
                <StackPanel x:Name="DoneStep" Margin="0,40,0,0" Visibility="Collapsed">
                    <Border Width="72"
                            Height="72"
                            Background="{ui:ThemeResource SystemAccentColorSecondaryBrush}"
                            CornerRadius="36">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="38" Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="This PC is connected" />
                    <TextBlock x:Name="DoneDetail"
                               MaxWidth="520"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="32,16"
                Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13"
                               Text="Step 1 of 3 · Enter the connection details" />
                    <ProgressBar x:Name="InstallProgress"
                                 Width="320"
                                 Height="5"
                                 Margin="0,9,0,0"
                                 HorizontalAlignment="Left"
                                 Maximum="100"
                                 Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BackButton"
                               Margin="0,0,10,0"
                               MinWidth="104"
                               Click="BackButton_Click"
                               Content="Back"
                               IsEnabled="False" />
                    <ui:Button x:Name="NextButton"
                               MinWidth="140"
                               Appearance="Primary"
                               Click="NextButton_Click"
                               Content="Next"
                               Icon="{ui:SymbolIcon ArrowRight24}" />
                    <ui:Button x:Name="FinishButton"
                               MinWidth="140"
                               Appearance="Primary"
                               Click="FinishButton_Click"
                               Content="Finish"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
