<Window x:Class="KidTime.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidTime Setup" Width="690" Height="700"
        MinWidth="620" MinHeight="650" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#F5F8F6">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#16784A" Padding="34,28">
      <StackPanel>
        <TextBlock Text="KIDTIME" Foreground="#CFE9DB" FontSize="12" FontWeight="Bold" />
        <TextBlock Text="Connect this Windows PC" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" />
        <TextBlock Text="Enter the details shown by Add device in the parent web panel." Foreground="#E8F5EE" FontSize="14" Margin="0,7,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="34,28,34,22">
        <Border Background="White" BorderBrush="#E0E7E3" BorderThickness="1" CornerRadius="12" Padding="24">
          <StackPanel>
            <TextBlock Text="1  Server URL" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="The address shown in the KidTime web panel." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,8" />
            <TextBox x:Name="ServerUrlBox" AutomationProperties.Name="Server URL" />

            <TextBlock Text="2  Enrollment token" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="This one-time token expires after 30 minutes." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,8" />
            <TextBox x:Name="EnrollmentTokenBox" AutomationProperties.Name="Enrollment token" />

            <TextBlock Text="3  Child user" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="KidTime controls only this Standard User account. Administrator accounts are never offered." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8" />
            <ComboBox x:Name="ChildUserBox" DisplayMemberPath="Label" AutomationProperties.Name="Child user" />
          </StackPanel>
        </Border>

        <Border x:Name="MessageBorder" Visibility="Collapsed" Background="#FFF5E6" BorderBrush="#EAC07A" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,16,0,0">
          <TextBlock x:Name="MessageText" Foreground="#6A4711" TextWrapping="Wrap" FontSize="13" />
        </Border>

        <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" Margin="0,24,0,0" HorizontalAlignment="Center">
          <Border Width="56" Height="56" CornerRadius="28" Background="#DDF2E6">
            <TextBlock Text="✓" Foreground="#16784A" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="This PC is connected" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,0" />
          <TextBlock x:Name="SuccessText" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500" Margin="0,6,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="#E0E7E3" BorderThickness="0,1,0,0" Padding="34,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Ready to connect" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <ProgressBar x:Name="InstallProgress" Visibility="Collapsed" IsIndeterminate="True" Width="310" Height="4" Margin="0,7,0,0" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
        <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Click="ConnectButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
        <Button x:Name="CloseButton" Grid.Column="1" Content="Finish" Click="CloseButton_Click" Visibility="Collapsed" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
      </Grid>
    </Border>
  </Grid>
</Window>
